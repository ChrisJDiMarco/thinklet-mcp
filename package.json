{
  "name": "thinklet-mcp",
  "version": "0.3.0",
  "description": "MCP server for creating, publishing, and discovering Thinklets — browser-native AI-powered micro-tools",
  "type": "module",
  "bin": {
    "thinklet-mcp": "./dist/index.js"
  },
  "scripts": {
    "build:ui": "cross-env INPUT=viewer.html vite build",
    "build:server": "tsc",
    "build": "npm run build:ui && npm run build:server",
    "dev": "tsx src/index.ts",
    "dev:http": "MCP_TRANSPORT=http tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@twind/core": "^1.1.3",
    "@twind/preset-tailwind": "^1.1.4",
    "jose": "^5.10.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sucrase": "^3.35.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^10.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.8",
    "vite-plugin-singlefile": "^2.3.2"
  }
}
