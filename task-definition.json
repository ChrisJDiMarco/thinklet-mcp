{
  "family": "thinklet-mcp",
  "networkMode": "bridge",
  "executionRoleArn": "arn:aws:iam::891612574251:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "thinklet-mcp",
      "image": "891612574251.dkr.ecr.us-east-1.amazonaws.com/thinklet/mcp:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3000,
          "hostPort": 0,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "MCP_TRANSPORT",
          "value": "http"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "THINKLET_API_URL",
          "value": "https://api.thinklet.io"
        },
        {
          "name": "THINKLET_APP_URL",
          "value": "https://app.thinklet.io"
        },
        {
          "name": "THINKLET_CONTENT_URL",
          "value": "https://content.thinklet.io"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/thinklet-mcp",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://localhost:3000/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      }
    }
  ],
  "requiresCompatibilities": ["EC2"],
  "cpu": "256",
  "memory": "512"
}
